{
  "manifest_version": 3,
  "name": "SmartJobTracker",
  "version": "1.7.0",
  "description": "Ajoute une offre d'emploi à SmartJobTracker en 1 clic + Autofill IA des formulaires de candidature",
  "icons": {
    "48": "icon48.png",
    "96": "icon96.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png",
      "96": "icon96.png"
    },
    "default_title": "SmartJobTracker"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["browser-polyfill.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": true
  }],
  "homepage_url": "https://www.smartjobtracker.com"
}
