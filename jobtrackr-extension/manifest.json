{
  "manifest_version": 2,
  "name": "SmartJobTracker",
  "version": "1.7.0",
  "description": "Ajoute une offre d'emploi à SmartJobTracker en 1 clic + Autofill IA des formulaires de candidature",
  "icons": {
    "48": "icon48.png",
    "96": "icon96.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "contextMenus",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png",
      "96": "icon96.png"
    },
    "default_title": "SmartJobTracker"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": true
  }],
  "homepage_url": "https://www.smartjobtracker.com",
  "developer": {
    "name": "Alexandre Leblanc",
    "url": "https://www.smartjobtracker.com"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "jobtrackr@deviloufr.dev",
      "strict_min_version": "120.0",
      "data_collection_permissions": {
        "required": ["websiteContent", "personallyIdentifyingInfo"]
      }
    },
    "gecko_android": {
      "strict_min_version": "120.0"
    }
  }
}
